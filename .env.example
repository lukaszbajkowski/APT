# Skopiuj do .env i uzupełnij. Plik .env NIE trafia do repozytorium.

# Domena, pod którą działa aplikacja (Caddy pobierze dla niej certyfikat Let's Encrypt).
# Lokalnie na swoim komputerze wpisz :80 (zwykłe http://localhost, bez certyfikatu)
# i ustaw niżej APT_COOKIE_SECURE=false.
APT_DOMAIN=:80

# Porty na komputerze (zmień, jeśli 80 jest zajęty, np. APT_HTTP_PORT=8080 -> http://localhost:8080)
APT_HTTP_PORT=80
APT_HTTPS_PORT=443

# Baza danych (w haśle używaj tylko liter i cyfr)
POSTGRES_DB=apt
POSTGRES_USER=apt
POSTGRES_PASSWORD=zmien-mnie-na-dlugie-losowe-haslo

# Klucz aplikacji (podpisy, HMAC). Wygeneruj: python -c "import secrets; print(secrets.token_urlsafe(48))"
APT_SECRET_KEY=zmien-mnie

# Klucz szyfrowania PESEL (32 bajty, base64url). Wygeneruj:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
# UWAGA: bez tego klucza zaszyfrowanych numerów PESEL nie da się odczytać.
# Przechowuj jego kopię bezpiecznie, poza serwerem (np. w menedżerze haseł).
APT_DATA_KEY=

# true w produkcji (ciasteczka tylko przez HTTPS). Lokalnie na http://localhost ustaw false.
APT_COOKIE_SECURE=true

# Czas bezczynności sesji (minuty) i maksymalny czas sesji (godziny)
APT_SESSION_IDLE_MINUTES=30
APT_SESSION_MAX_HOURS=12

# Blokada konta po nieudanych logowaniach
APT_LOGIN_MAX_FAILURES=5
APT_LOGIN_LOCK_MINUTES=15

# Logowanie dwuetapowe obowiązkowe dla Administratora i Kadr (wyłączaj tylko lokalnie do testów)
APT_MFA_ENFORCE=true
