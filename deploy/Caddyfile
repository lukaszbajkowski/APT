{$APT_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	# API nie odpowiada (aktualizacja, restart, awaria): zamiast pustego błędu 502 – czytelna odpowiedź,
	# po której aplikacja pokazuje ekran „Serwis chwilowo niedostępny” i sama sprawdza, kiedy serwer wróci.
	handle_errors 502 503 504 {
		@api path /api/*
		handle @api {
			header Content-Type "application/json; charset=utf-8"
			header Cache-Control "no-store"
			respond `{"detail":"Serwis jest chwilowo niedostępny – trwa przerwa techniczna. Spróbuj za kilka minut.","maintenance":true}` 503
		}
	}

	handle {
		root * /srv
		# pliki z hashem w nazwie nigdy się nie zmieniają; index.html zawsze sprawdzany na nowo
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
